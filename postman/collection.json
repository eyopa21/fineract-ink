            "url": {
              "raw": "{{integration_url}}/api/loans/{{loan_reference}}",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loan_reference}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Disburse (amount optional = approved principal)",
