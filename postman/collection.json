            "description": "One per loan; replay returns the same result",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{loan_reference}}-DISB\",\n  \"disbursed_on\": \"2026-01-15\"\n}"
            }
          }
        },
        {
          "name": "Repayment 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
