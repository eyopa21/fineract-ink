{
  "info": {
    "name": "Fineract Assessment",
    "description": "Integration Service and Mock ERP. Set the collection variables; run top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "integration_url",
      "value": "http://localhost:8100"
    },
    {
      "key": "erp_url",
      "value": "http://localhost:8101"
    },
    {
      "key": "api_key",
      "value": "partner-demo-key"
    },
    {
      "key": "erp_api_key",
      "value": "erp-demo-key"
    },
    {
      "key": "client_uid",
      "value": "SME-000001"
    },
    {
      "key": "loan_reference",
      "value": "LN-2026-000001"
    }
  ],
  "item": [
    {
      "name": "GL sync (Part A)",
      "item": [
        {
          "name": "Sync ERP chart of accounts into Fineract",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/accounts/sync",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "sync"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Mapping table",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/accounts/sync",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "sync"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Clients (Part C)",
      "item": [
        {
          "name": "Create client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/clients",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            },
            "description": "Idempotent on external_reference; client_uid unique",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"CLI-{{client_uid}}\",\n  \"client_uid\": \"{{client_uid}}\",\n  \"full_name\": \"Kigali Tools Ltd\",\n  \"activation_date\": \"2026-01-10\"\n}"
            }
          }
        },
        {
          "name": "Get client by client_uid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/clients/{{client_uid}}",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "clients",
                "{{client_uid}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Loans (Parts D, E, F)",
      "item": [
        {
          "name": "Apply + approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/loans",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "loans"
              ]
            },
            "description": "Issues loan_reference LN-YYYY-NNNNNN; copy it into the loan_reference variable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"APP-{{client_uid}}-1\",\n  \"client_uid\": \"{{client_uid}}\",\n  \"principal\": \"5000000\",\n  \"submitted_on\": \"2026-01-12\",\n  \"expected_disbursement_date\": \"2026-01-15\",\n  \"approve\": true\n}"
            }
          }
        },
        {
          "name": "Approve (when applied with approve=false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{integration_url}}/api/loans/{{loan_reference}}/approve",
              "host": [
                "{{integration_url}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loan_reference}}",
                "approve"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"APR-{{loan_reference}}\",\n  \"approved_on\": \"2026-01-13\"\n}"
            }
          }
        },
        {
          "name": "Get loan (Fineract status, balances, transactions)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
