# Copy to .env for a local run (uv run uvicorn ...). Values match the compose stack ports on the host.
# Real environment variables override these; the Docker stack uses docker-compose.yml instead.
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5432/erp
API_KEY=erp-demo-key
DEFAULT_CURRENCY=RWF
LOG_LEVEL=DEBUG
