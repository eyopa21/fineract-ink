# Copy to .env for a local run (uv run uvicorn ...). Values match the compose stack ports on the host.
# Real environment variables override these; the Docker stack uses docker-compose.yml instead.
DATABASE_URL=postgresql+psycopg://integration:integration@localhost:5432/integration
API_KEY=partner-demo-key

FINERACT_BASE_URL=http://localhost:8080/fineract-provider/api/v1
FINERACT_TENANT_ID=default
# runtime (least-privilege user created by setup); admin only for `python -m app.setup`
FINERACT_USERNAME=integration-api
FINERACT_PASSWORD=Integr8tion#2026
FINERACT_ADMIN_USERNAME=mifos
FINERACT_ADMIN_PASSWORD=password

ERP_BASE_URL=http://localhost:8101
ERP_API_KEY=erp-demo-key

SYNC_MAX_ATTEMPTS=3
SYNC_BACKOFF_S=0.5
LOG_LEVEL=DEBUG
